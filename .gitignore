# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp migration scripts
extract-css.ps1
extract-body.ps1
convert-to-jsx.js
src/app/body-content.html
src/app/landing-script.js

.vercel
.env*.local

# artefactos de herramientas de agente — se regeneran solos y no son del sitio.
# `.playwright-mcp/` acumula capturas y volcados de cada sesión de navegador:
# llegó a 23 MB sin que nadie lo notara, porque no estaba ignorado y aun así
# nadie lo commiteaba a propósito.
.playwright-mcp/
.verify/
skills-lock.json

# Skills de herramientas de IA instalados por `npx skills add`. Son del entorno
# de quien desarrolla, no del producto: se replican en cuatro carpetas (una por
# editor) y no aportan nada al sitio.
.agents/
.trae/
.windsurf/
.claude/skills/higgsfield-*

# Bocetos del canvas de diseño de /links. Material de trabajo, no código.
.design/
